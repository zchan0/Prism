{
  "sourceLanguage": "en",
  "strings": {
    "%@ awake today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天醒着 %@"
          }
        }
      }
    },
    "%@ free of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可用，共 %@"
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 %@"
          }
        }
      }
    },
    "%lld hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时"
          }
        }
      }
    },
    "%lld hr": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时"
          }
        }
      }
    },
    "%lld hr %lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时 %lld 分钟"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        }
      }
    },
    "%lld minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        }
      }
    },
    "%lld sessions together": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起醒了 %lld 次"
          }
        }
      }
    },
    "%lld%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%"
          }
        }
      }
    },
    "1 session together": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起醒了 1 次"
          }
        }
      }
    },
    "A spark that sleeps all day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一睡就是一整天的小火苗"
          }
        }
      }
    },
    "A sun that keeps your Mac awake, and gets brighter the longer you work.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一颗让 Mac 醒着的小太阳，工作越久它越亮。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Allow it in System Settings → General → Login Items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 通用 → 登录项”中允许"
          }
        }
      }
    },
    "Allow lid sleep to change, or System Settings → Energy may be affected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许修改合盖睡眠，否则会影响“系统设置 → 电池”。"
          }
        }
      }
    },
    "An administrator password is needed to change lid sleep.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改合盖睡眠需要管理员密码。"
          }
        }
      }
    },
    "Asks for your password once, then disables lid sleep until the session ends.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会要求输入一次密码，随后关闭合盖睡眠，直到本次会话结束。"
          }
        }
      }
    },
    "At %lld%, LumosMaxima stopped keeping your Mac awake.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量降到 %lld%，LumosMaxima 已停止让 Mac 保持唤醒。"
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Available includes space macOS can reclaim, which is the number Finder shows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「可用」包含 macOS 可回收的空间，也就是「访达」显示的数字。"
          }
        }
      }
    },
    "Awake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒着"
          }
        }
      }
    },
    "Awake for %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经醒着 %@"
          }
        }
      }
    },
    "Awake for %@ with no timer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经醒着 %@，没有定时"
          }
        }
      }
    },
    "Awake time is up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒时间到了"
          }
        }
      }
    },
    "Battery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池"
          }
        }
      }
    },
    "Battery is low": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量偏低"
          }
        }
      }
    },
    "Blazes after six hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒着六小时后熊熊燃烧"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Capacity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量"
          }
        }
      }
    },
    "Changing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在切换…"
          }
        }
      }
    },
    "charging": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充电中"
          }
        }
      }
    },
    "Click to open the controls, drag to move": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击打开快捷面板，双击打开设置，拖动换位置"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Could not keep this Mac awake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法让这台 Mac 保持唤醒"
          }
        }
      }
    },
    "Default length": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认时长"
          }
        }
      }
    },
    "Disk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘"
          }
        }
      }
    },
    "Disk and memory refresh every 20 seconds, and whenever the panel opens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘和内存每 20 秒刷新一次，打开面板时也会刷新。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Drag it anywhere; it naps while the Mac may sleep.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以拖到任何地方；Mac 能睡时它会打盹。"
          }
        }
      }
    },
    "Free": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "free of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用，共 %@"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "Goes supernova after ten hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒着十小时后成为超新星"
          }
        }
      }
    },
    "Includes space macOS can reclaim when it needs it, which is the number Finder shows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 macOS 在需要时可回收的空间，也就是「访达」显示的数字。"
          }
        }
      }
    },
    "It grows every hour it keeps your Mac awake, and naps on days it does not.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它每让你的 Mac 醒着一小时就会长大一点，闲着的时候打盹。"
          }
        }
      }
    },
    "It hasn’t woken up today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没醒过"
          }
        }
      }
    },
    "Keep Awake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持唤醒"
          }
        }
      }
    },
    "Keep running with the lid closed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上盖子也继续运行"
          }
        }
      }
    },
    "Keep the screen on too": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保持屏幕常亮"
          }

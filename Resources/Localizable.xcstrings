      }
    },
    "The lid setting did not change. Try again, or turn it off in System Settings → Battery.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖设置没有生效。请重试，或到“系统设置 → 电池”里关掉。"
          }
        }
      }
    },
    "The panel is always reachable with the shortcut, even with the icon hidden.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有独立图标，面板仍可用快捷键打开。"
          }
        }
      }
    },
    "This volume is not available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个卷当前不可用。"
          }
        }
      }

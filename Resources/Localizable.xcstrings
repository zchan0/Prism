    "Each reading that is on gets its own icon. To take Vitals out of the menu bar, turn off Show in the menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每项打开的读数各有一个图标。要让 Vitals 离开菜单栏，请关掉「显示在菜单栏」。"
          }
        }
      }
    },
    "Edit…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑…"
          }
        }
      }
    },
    "Every reading refreshes every 20 seconds, and whenever the panel opens. CPU shows the average load since the last refresh." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有读数每 20 秒刷新一次，打开面板时也会刷新。CPU 显示的是上次刷新以来的平均占用率。"
          }
        }
      }
    },

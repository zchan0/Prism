    "Allow lid sleep to change, or System Settings → Energy may be affected." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许修改合盖睡眠，否则会影响“系统设置 → 电池”。" } }
      }
    },
    "An administrator password is needed to change lid sleep." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "修改合盖睡眠需要管理员密码。" } }
      }
    },
    "Allow it in System Settings → General → Login Items" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“系统设置 → 通用 → 登录项”中允许" } }
      }
    },
    "Asks for your password once, then disables lid sleep until the session ends." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会要求输入一次密码，随后关闭合盖睡眠，直到本次会话结束。" } }
      }
    },
    "At %lld%%, LumosMaxima stopped keeping your Mac awake." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电量降到 %lld%%，LumosMaxima 已停止让 Mac 保持唤醒。" } }
      }
    },
    "A sun that keeps your Mac awake, and gets brighter the longer you work." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一颗让 Mac 醒着的小太阳，工作越久它越亮。" } }
      }
    },
    "A spark that sleeps all day" : {

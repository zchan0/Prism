    "Add app" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 app"
          }
        }
      }
    },
    "Allow it in System Settings → General → Login Items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 通用 → 登录项”中允许"
          }
        }
      }
    },
    "An administrator password is needed to change lid sleep." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改合盖睡眠需要管理员密码。"
          }
        }
      }
    },
    "Apps and shortcuts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 与快捷键"
          }
        }
      }
    },
    "Asks for your password once, then disables lid sleep until the session ends." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会要求输入一次密码，随后关闭合盖睡眠，直到本次会话结束。"
          }
        }
      }
    },
    "At %lld%%, Prism stopped keeping your Mac awake." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电量降到 %lld%%，Prism 已停止让 Mac 保持唤醒。"
          }
        }
      }
    },
    "Available includes space macOS can reclaim, which is the number Finder shows." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「可用」包含 macOS 可回收的空间，也就是「访达」显示的数字。"
          }
        }
      }
    },
